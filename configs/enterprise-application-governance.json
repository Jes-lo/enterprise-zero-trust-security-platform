    "permission_grant_creation": false,
    "permission_grant_removal": false,
    "admin_consent": false,
    "user_assignment_changes": false,
    "service_principal_deletion": false
  },
  "graph_discovery": {
    "stage1": {
      "name": "enterprise_application_inventory",
      "graph_surface": "v1.0",
      "scope": "Application.Read.All",
      "http_methods": [
        "GET"
      ],
      "execution_authorized": false,
      "purpose": [
        "service_principal_inventory",
        "tenant_owned_application_inventory",
